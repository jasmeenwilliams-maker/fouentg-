            ])
          ]],
          ['2. Non-Clinical Home Safety & Lifestyle Walkthrough', [
            c('Environmental & Fall Hazards Observed', [
              'Loose throw rugs',
              'Dim hallways / stairs',
              'Cluttered walkways / cords',
              'Missing bathroom grab bars',
