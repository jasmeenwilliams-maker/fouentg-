      const userInput = document.getElementById('client-id-input').value.trim();
      const pwdInput = document.getElementById('passcode-input').value.trim();
      const errBox = document.getElementById('auth-error-msg');

      if (VALID_PASSCODES.includes(pwdInput.toLowerCase())) {
        errBox.style.display = 'none';
        sessionStorage.setItem(AUTH_KEY, "true");
        sessionStorage.setItem(AUTH_USER_KEY, userInput || "Margaret E. Carlisle");
        
        // Auto-seed client name if not already set
        if (!S['client']) {
          S['client'] = userInput;
          save();
        }

        document.getElementById('auth-screen').style.display = 'none';
        document.getElementById('portal-content').style.display = 'flex';
        document.getElementById('active-user-display').textContent = userInput || "Margaret E. Carlisle";
        
        // Sync any inputs tagged with data-c
        document.querySelectorAll('input[data-c]').forEach(o => {
          if (!o.value) o.value = userInput;
        });
      } else {
        errBox.style.display = 'block';
        document.getElementById('passcode-input').focus();
        document.getElementById('passcode-input').select();
      }
    }

    function togglePasswordVisibility() {
      const input = document.getElementById('passcode-input');
      const icon = document.getElementById('pwd-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        input.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    function lockPortal() {
      sessionStorage.removeItem(AUTH_KEY);
      sessionStorage.removeItem(AUTH_USER_KEY);
      document.getElementById('passcode-input').value = '';
      checkExistingAuth();
