    const e = (tag, a, ...k) => {
      const x = document.createElement(tag);
      Object.assign(x, a || {});
      k.forEach(i => x.append(i));
      return x;
    };

    function item(it) {
      const w = e('div');
      if (it.y == 'n') return e('p', { className: 'note', textContent: it.x });
      if (it.y == 'x') {
        w.append(e('span', { className: 'lab', textContent: it.l }), e('div', { className: 'fixed', textContent: it.x }));
        return w;
      }
      if (it.y == 'f') {
        w.append(e('label', { className: 'l', textContent: it.l }));
        const i = e('input', { type: it.t, value: S[it.k] || '' });
        i.oninput = () => {
          S[it.k] = i.value;
          save();
          if (it.k == 'client') {
            document.querySelectorAll('input[data-c]').forEach(o => {
              if (o !== i) o.value = i.value;
            });
          }
        };
        if (it.k == 'client') i.dataset.c = 1;
        w.append(i);
        return w;
      }
      if (it.y == 't') {
        w.append(e('label', { className: 'l', textContent: it.l }));
        const i = e('textarea', { value: S[it.k] || '' });
        i.oninput = () => { S[it.k] = i.value; save(); };
        w.append(i);
        return w;
      }
      if (it.y == 'c') {
        w.append(e('span', { className: 'lab', textContent: it.l }));
        const o = e('div', { className: 'opts' + (it.o.some(x => x.length > 40) ? ' col' : '') });
        const boxes = [];
        it.o.forEach(v => {
          const i = e('input', { type: 'checkbox', checked: (S[it.k] || []).includes(v) });
          boxes.push([i, v]);
          i.onchange = () => {
            if (it.s && i.checked) {
              boxes.forEach(([b]) => { if (b !== i) b.checked = false; });
            }
            S[it.k] = boxes.filter(([b]) => b.checked).map(([, x]) => x);
            save();
          };
          o.append(e('label', { className: 'opt' }, i, e('span', { textContent: v })));
        });
        w.append(o);
        return w;
      }
      if (it.y == 'i') {
        const i = e('input', { type: 'text', placeholder: 'Initials', maxLength: 4, value: S[it.k] || '' });
        i.oninput = () => { S[it.k] = i.value; save(); };
        return e('div', { className: 'scope' }, e('p', { textContent: it.x }), i);
      }
      if (it.y == 'b') {
        const T = e('table'), r = e('tr');
        it.h.forEach(h => r.append(e('th', { textContent: h })));
        T.append(r);
        it.rows.forEach((rw, ri) => {
          const tr = e('tr');
          it.h.forEach((_, ci) => {
            const td = e('td');
            if (ci == 0 && it.fx && /[A-Za-z]/.test(rw) && rw.length > 3) {
              td.className = 'fx';
              td.textContent = rw;
            } else {
              const key = it.k + '_' + ri + '_' + ci;
              const i = e('input', { type: 'text', value: S[key] || '' });
              i.oninput = () => { S[key] = i.value; save(); };
              td.append(i);
            }
            tr.append(td);
          });
          T.append(tr);
        });
        return e('div', { style: 'overflow-x:auto' }, T);
      }
      if (it.y == 's') {
        w.append(e('span', { className: 'lab', textContent: it.l }));
        const cv = e('canvas', { width: 480, height: 120, className: 'sig-pad' });
        const g = cv.getContext('2d');
        g.lineWidth = 2;
        g.lineCap = 'round';
        g.strokeStyle = '#16263B';
        
        if (S[it.k]) {
          const im = new Image();
          im.onload = () => g.drawImage(im, 0, 0);
          im.src = S[it.k];
        }
        
        let d = 0;
        const p = ev => {
          const r = cv.getBoundingClientRect();
          return [(ev.clientX - r.left) * 480 / r.width, (ev.clientY - r.top) * 120 / r.height];
        };
        
        cv.onpointerdown = ev => {
          d = 1;
          cv.setPointerCapture(ev.pointerId);
          const [x, y] = p(ev);
          g.beginPath();
          g.moveTo(x, y);
          g.lineTo(x + .1, y);
          g.stroke();
        };
        cv.onpointermove = ev => {
          if (!d) return;
          const [x, y] = p(ev);
          g.lineTo(x, y);
          g.stroke();
        };
        cv.onpointerup = () => {
          d = 0;
          try { S[it.k] = cv.toDataURL(); save(); } catch(e) {}
        };
        
        const cb = e('button', { className: 'btn alt', textContent: 'Clear signature', type: 'button' });
        cb.onclick = () => {
          g.clearRect(0, 0, 480, 120);
          delete S[it.k];
          save();
        };
        w.append(cv, e('div', { className: 'sigbar' }, cb));
        return w;
      }
    }

    const app = document.getElementById('form-app'), nav = document.getElementById('stage-nav');
    
    D.forEach((st, i) => {
      const s = e('section', { className: 'stage', id: 's' + i });
      s.append(e('h2', { textContent: st.h }), e('p', { className: 'sub', textContent: st.s }));
      
      st.x.forEach(([h, items]) => {
        const b = e('div', { className: 'body' });
        b.innerHTML = '';
        let gr = null;
        items.forEach(it => {
          const el = item(it);
          if (it.y == 'f' || it.y == 'x') {
            if (!gr) {
              gr = e('div', { className: 'grid' });
              b.append(gr);
            }
            gr.append(el);
          } else {
            gr = null;
            b.append(el);
          }
        });
        s.append(e('div', { className: 'card' }, e('h3', { textContent: h }), b));
      });
      
      const ctl = e('div', { className: 'ctl' });
      const mk = (t, fn, a) => {
        const b = e('button', { className: 'btn' + (a ? ' alt' : ''), textContent: t, type: 'button' });
        b.onclick = fn;
        return b;
      };
      
      ctl.append(
        mk('← Previous Stage', () => go(i - 1), 1),
        mk('Print This Stage', () => pr(i), 1),
        i < 4 ? mk('Next Stage →', () => go(i + 1)) : mk('Print Full 5-Stage Packet', () => pr())
      );
      s.append(ctl);
      app.append(s);
      
      const nb = e('button', { textContent: 'Stage ' + (i + 1), type: 'button' });
      nb.onclick = () => go(i);
      nav.append(nb);
    });

    const clr = e('button', { className: 'btn-clear', textContent: 'Reset All Data', type: 'button' });
    clr.onclick = () => {
      if (confirm('Clear every recorded field across all 5 stages? This cannot be undone.')) {
        S = {};
        save();
        location.reload();
      }
    };
    nav.append(clr);

    function go(i) {
      if (i < 0 || i > 4) return;
      cur = i;
      document.querySelectorAll('.stage').forEach((s, j) => s.classList.toggle('on', j == i));
      [...nav.children].forEach((b, j) => {
        if (j < 5) b.classList.toggle('on', j == i);
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function pr(i) {
      document.querySelectorAll('.stage').forEach(s => s.classList.remove('only'));
      if (i == null) {
        document.body.removeAttribute('data-only');
      } else {
        document.body.dataset.only = 1;
        document.getElementById('s' + i).classList.add('only');
      }
      window.print();
    }

    // Initialize state
    go(0);
    checkExistingAuth();
  </script>



