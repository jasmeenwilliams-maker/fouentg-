  <!-- PASSWORD / PIN PROTECTION GATE -->
  <section id="auth-screen" style="display: flex;">
    <div class="auth-container">
      <div class="auth-header">
        <div class="shield-badge">
          <span class="material-symbols-outlined" style="font-size:28px;">verified_user</span>
        </div>
        <h2>Client &amp; Family Access</h2>
        <p>Please enter your authorized household passcode or client PIN to access the 5-stage Care Dossier enrollment forms.</p>
      </div>

      <div class="auth-body">
        <form id="auth-form" onsubmit="event.preventDefault(); verifyPasscode();">
          <div class="auth-field">
            <label for="client-id-input">Client Household ID or Name</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined">person</span>
              <input id="client-id-input" class="auth-input" type="text" placeholder="e.g. Carlisle or SW-2025" required="" autofocus="">
            </div>
          </div>

          <div class="auth-field">
            <label for="passcode-input">Access PIN / Password</label>
            <div class="input-wrap">
              <span class="material-symbols-outlined">key</span>
              <input id="passcode-input" class="auth-input" type="password" placeholder="Enter secure PIN" required="">
              <button type="button" class="toggle-pwd" id="toggle-pwd-btn" onclick="togglePasswordVisibility()" title="Show/Hide PIN">
                <span class="material-symbols-outlined" id="pwd-icon">visibility</span>
              </button>
            </div>
          </div>

          <button type="submit" class="auth-btn">
            <span class="material-symbols-outlined" style="font-size:18px;">lock_open</span>
            <span>Unlock Care Enrollment Forms</span>
          </button>

          <div id="auth-error-msg" class="auth-error">
            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:text-bottom;margin-right:4px;">error</span>
            Incorrect passcode. Please verify with Jasmeen Williams or try default PIN: <strong>southernwell2025</strong>
          </div>

          <div class="portal-credentials-hint">
            <div style="font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:4px;">
              <span class="material-symbols-outlined" style="font-size:16px;color:var(--sage);">info</span>
              <span>Client &amp; Coordinator Demo Passcode</span>
            </div>
            Passcode: <strong style="letter-spacing:0.04em;">southernwell2025</strong> or <strong style="letter-spacing:0.04em;">2025</strong><br>
            <span style="font-size:11px;opacity:0.85;">All entries save automatically in this browser session.</span>
          </div><div style="text-align: center; margin-top: 18px;"><button type="button" id="open-request-access-btn" onclick="openRequestModal()" style="background: none; border: none; color: #16263B; font-size: 13px; font-weight: 600; text-decoration: underline; cursor: pointer; text-underline-offset: 3px; transition: color 0.2s;">Forgot PIN or Need Household Access?</button></div>
        </form>
      </div>
    </div>
  </section>

  <!-- LOGGED-IN PROTECTED APPLICATION (5-STAGE FORMS) -->
  <div id="portal-content" style="display: none;">
    <div class="portal-bar">
      <div class="session-badge">
        <span class="live-dot"></span>
        <span>Secure Active Session: <strong id="active-user-display" style="color:var(--oxford);">Estate Record</strong></span>
      </div>
      <div style="display:flex;align-items:center;gap:10px;">
        <span style="color:var(--sage);font-size:11px;">Administered by Jasmeen Williams, LPN, BS-HHS</span>
        <button class="btn-lock" type="button" id="export-records-btn" onclick="exportClientRecords()" title="Export Client Dossier Records (JSON)"><span class="material-symbols-outlined" style="font-size:16px;">file_download</span><span>Export Records</span></button><button class="btn-lock" type="button" id="export-meds-bar-btn" onclick="exportMedicationReconciliationCSV()" title="Export Medication Reconciliation Table as CSV"><span class="material-symbols-outlined" style="font-size:16px;color:var(--sage);">table_view</span><span>Export Meds (CSV)</span></button><button class="btn-lock" type="button" onclick="lockPortal()">
          <span class="material-symbols-outlined" style="font-size:16px;">lock</span>
          <span>Lock Portal</span>
        </button>
      </div>
