          fx = (l, x) => ({ y: 'x', l, x });

    const cl = f('Senior Client Legal Name', 'client');

    const D = [
      {
        h: 'Stage 1 of 5 • Initial Consultation',
        s: 'Inquiry & Discovery Call Form (30-Minute Consultation) — Phone, Video, or In-Person',
        x: [
