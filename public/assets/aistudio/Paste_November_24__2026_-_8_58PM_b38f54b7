<!DOCTYPE html><html lang="en"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Southern Well Senior Concierge — Secure Client &amp; Family Forms Portal</title>
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
  
  <style>
    :root {
      --bg: #F7F5F0;
      --card: #ffffff;
      --ink: #1A1B1E;
      --oxford: #16263B;
      --oxford-dark: #0B1623;
      --brass: #B08D57;
      --brass-light: #DFC9A2;
      --sage: #3D5A4C;
      --sage-light: #E5EFE9;
      --line: #E8E5DD;
      --error: #BA1A1A;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .font-serif {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }

    /* Top Branding Strip */
    header {
      background: var(--oxford);
      color: #fff;
      padding: 16px 20px;
      border-bottom: 2px solid var(--brass);
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 4px 16px rgba(11,22,35,0.08);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }
    .brand-mark {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: #fff;
      border: 1.5px solid var(--brass-light);
      padding: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .brand-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 700;
      font-size: 20px;
      letter-spacing: 0.5px;
      line-height: 1.1;
    }
    .brand-sub {
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--brass-light);
      font-weight: 600;
    }

    /* Auth Gate Layer (Password Protection) */
    #auth-screen {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px 48px;
    }
    .auth-container {
      width: 100%;
      max-width: 480px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: 0 12px 36px rgba(22, 38, 59, 0.08);
      overflow: hidden;
      animation: fadeIn 0.3s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .auth-header {
      background: linear-gradient(135deg, var(--oxford) 0%, var(--oxford-dark) 100%);
      color: #fff;
      padding: 32px 28px 26px;
      text-align: center;
      border-bottom: 3px solid var(--brass);
      position: relative;
    }
    .shield-badge {
      width: 52px;
      height: 52px;
      margin: 0 auto 14px;
      border-radius: 50%;
      background: rgba(176, 141, 87, 0.15);
      border: 1px solid var(--brass-light);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--brass-light);
    }
    .auth-header h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 26px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 6px;
    }
    .auth-header p {
      font-size: 13px;
      color: rgba(247, 245, 240, 0.85);
      line-height: 1.45;
    }
    .auth-body {
      padding: 28px 28px 24px;
    }
    .auth-field {
      margin-bottom: 20px;
    }
    .auth-field label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--oxford);
      margin-bottom: 7px;
    }
    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-wrap .material-symbols-outlined {
      position: absolute;
      left: 12px;
      color: var(--sage);
      font-size: 20px;
      pointer-events: none;
    }
    .auth-input {
      width: 100%;
      padding: 12px 12px 12px 42px;
      border: 1.5px solid var(--line);
      border-radius: 8px;
      background: var(--bg);
      font-family: inherit;
      font-size: 15px;
      color: var(--ink);
      transition: all 0.2s;
    }
    .auth-input:focus {
      outline: none;
      border-color: var(--oxford);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(22, 38, 59, 0.1);
    }
    .toggle-pwd {
      position: absolute;
      right: 10px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--sage);
      display: flex;
      padding: 4px;
    }
    .auth-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 8px;
      background: var(--oxford);
      color: #fff;
      font-family: inherit;
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(22, 38, 59, 0.15);
    }
    .auth-btn:hover {
      background: var(--oxford-dark);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(22, 38, 59, 0.22);
    }
    .auth-error {
      display: none;
      margin-top: 14px;
      padding: 10px 14px;
      background: #FDEDEC;
      border: 1px solid #F5B7B1;
      border-radius: 6px;
      color: var(--error);
      font-size: 12px;
      font-weight: 500;
      text-align: center;
      animation: shake 0.3s;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }
    .portal-credentials-hint {
      margin-top: 24px;
      padding: 14px;
      background: var(--sage-light);
      border-radius: 8px;
      border: 1px dashed var(--sage);
      font-size: 12px;
      color: var(--oxford);
      line-height: 1.5;
    }
    .portal-credentials-hint strong {
      color: var(--sage);
    }

    /* Logged In Portal Shell */
    #portal-content {
      display: none;
      flex: 1;
      flex-direction: column;
    }
    .portal-bar {
      background: #fff;
      border-bottom: 1px solid var(--line);
      padding: 10px 20px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-size: 13px;
    }
    .session-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--sage);
      font-weight: 500;
    }
    .session-badge .live-dot {
      width: 8px;
      height: 8px;
      background: #2E7D32;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.4); }
      70% { box-shadow: 0 0 0 6px rgba(46, 125, 50, 0); }
      100% { box-shadow: 0 0 0 0 rgba(46, 125, 50, 0); }
    }
    .btn-lock {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--oxford);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: all 0.2s;
    }
    .btn-lock:hover {
      background: var(--bg);
      border-color: var(--oxford);
    }

    /* Workflow Stage Navigator */
    nav#stage-nav {
      display: flex;
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
      padding: 12px 14px;
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 20;
      border-bottom: 1px solid var(--line);
    }
    nav#stage-nav button {
      font-family: inherit;
      font-size: 13px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--oxford);
      padding: 7px 14px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.15s;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    nav#stage-nav button:hover {
      border-color: var(--brass);
    }
    nav#stage-nav button.on {
      background: var(--oxford);
      color: #fff;
      border-color: var(--oxford);
      font-weight: 600;
    }
    nav#stage-nav button.btn-clear {
      color: var(--error);
      border-color: #FADBD8;
      background: #FDEDEC;
    }

    /* Form Container */
    main#form-app {
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding: 24px 16px;
      flex: 1;
    }
    .stage {
      display: none;
    }
    .stage.on {
      display: block;
      animation: fadeIn 0.25s ease-out;
    }
    .stage > h2 {
      color: var(--oxford);
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .sub {
      font-style: italic;
      color: #555A64;
      font-size: 13px;
      margin-bottom: 18px;
    }

    /* Cards & Layout */
    .card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      margin: 16px 0;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(22, 38, 59, 0.03);
    }
    .card h3 {
      background: var(--oxford);
      color: #fff;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 10px 14px;
      font-weight: 600;
      border-bottom: 2px solid var(--brass);
    }
    .body {
      padding: 16px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
    }
    label.l, .lab {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: var(--oxford);
      margin: 6px 0 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    input[type=text], input[type=date], input[type=datetime-local], textarea {
      width: 100%;
      font-family: inherit;
      font-size: 14px;
      padding: 8px 10px;
      border: 1px solid var(--line);
      background: var(--bg);
      color: var(--ink);
      border-radius: 6px;
      transition: all 0.2s;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: var(--oxford);
      background: #fff;
      box-shadow: 0 0 0 2px rgba(22, 38, 59, 0.08);
    }
    textarea {
      min-height: 80px;
      resize: vertical;
    }
    .opts {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      margin-top: 4px;
    }
    .opts.col {
      flex-direction: column;
    }
    .opt {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      cursor: pointer;
      font-size: 13px;
      color: var(--ink);
      padding: 3px 0;
    }
    .opt input {
      margin-top: 3px;
      accent-color: var(--oxford);
      width: 16px;
      height: 16px;
      flex: none;
    }
    .note {
      font-size: 13px;
      line-height: 1.5;
      color: #4A4D55;
      margin: 8px 0;
      background: #FAF9F6;
      padding: 10px 12px;
      border-left: 3px solid var(--brass);
      border-radius: 0 6px 6px 0;
    }
    .scope {
      border-top: 1px dashed var(--line);
      padding: 10px 0;
      display: flex;
      gap: 12px;
      align-items: center;
      font-size: 13px;
    }
    .scope p {
      flex: 1;
      margin: 0;
      color: #333;
    }
    .scope input {
      width: 80px;
      text-align: center;
      font-weight: 700;
      text-transform: uppercase;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin-top: 8px;
    }
    th {
      background: var(--oxford);
      color: #fff;
      text-align: left;
      padding: 8px 10px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    td {
      border: 1px solid var(--line);
      padding: 0;
      background: #fff;
    }
    td.fx {
      padding: 8px 10px;
      font-weight: 600;
      color: var(--oxford);
      background: var(--bg);
      width: 28%;
    }
    td input {
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 8px 10px;
    }
    canvas.sig-pad {
      width: 100%;
      max-width: 480px;
      height: 120px;
      border: 1.5px solid var(--line);
      border-radius: 6px;
      background: #fff;
      touch-action: none;
      display: block;
      margin-top: 6px;
    }
    .sigbar {
      display: flex;
      gap: 8px;
      margin-top: 6px;
    }
    .btn {
      font-family: inherit;
      font-size: 13px;
      border: 1px solid var(--oxford);
      background: var(--oxford);
      color: #fff;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.15s;
    }
    .btn.alt {
      background: transparent;
      color: var(--oxford);
      border-color: var(--line);
    }
    .btn.alt:hover {
      background: var(--bg);
      border-color: var(--oxford);
    }
    .ctl {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: space-between;
      margin: 24px 0 12px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }
    .fixed {
      padding: 8px 10px;
      border-bottom: 1.5px solid var(--line);
      font-weight: 600;
      color: var(--oxford);
    }

    footer {
      background: var(--oxford-dark);
      color: rgba(247, 245, 240, 0.7);
      text-align: center;
      font-size: 12px;
      padding: 20px 16px;
      border-top: 1px solid rgba(255,255,255,0.1);
      margin-top: auto;
      line-height: 1.6;
    }

    @media print {
      header, .portal-bar, nav#stage-nav, .ctl, .sigbar, footer, #auth-screen {
        display: none !important;
      }
      body {
        background: #fff;
        color: #000;
        font-size: 12px;
      }
      #portal-content {
        display: block !important;
      }
      .stage {
        display: block !important;
        page-break-after: always;
      }
      body[data-only] .stage:not(.only) {
        display: none !important;
      }
      .card {
        break-inside: avoid;
        border-color: #999;
      }
      .card h3, th {
        background: #16263B !important;
        color: #fff !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      main#form-app {
        padding: 0;
        max-width: 100%;
      }
    }
  </style>
</head>
