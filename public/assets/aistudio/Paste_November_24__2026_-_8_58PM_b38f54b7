    <div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--brass-light);font-weight:600;">
      <span class="material-symbols-outlined" style="font-size:16px;">lock</span>
      <span>256-Bit Encrypted</span>
    </div>
