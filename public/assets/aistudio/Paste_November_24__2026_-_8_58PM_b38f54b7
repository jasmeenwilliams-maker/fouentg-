entListener('click',function(ev){if(ev.target===this){closeRequestModal();}});</script><div id="export-toast" style="display:none; position:fixed; bottom:24px; right:24px; z-index:99999; background:#16263B; color:#fff; border-left:4px solid #B08D57; border-radius:8px; padding:12px 18px; box-shadow:0 10px 30px rgba(11,22,35,0.3); font-size:13px; align-items:center; gap:10px; animation:fadeIn 0.25s ease-out;"><span class="material-symbols-outlined" style="color:#DFC9A2; font-size:20px;">check_circle</span><span id="export-toast-msg">Care Dossier records exported successfully.</span></div><script>function exportClientRecords(){let data={};try{data=JSON.parse(localStorage.getItem('swf')||'{}');}catch(e){data=typeof S!=='undefined'?S:{};}const clientName=(data['client']||sessionStorage.getItem('sw_auth_user')||'Client').replace(/[^a-zA-Z0-9_-]/g,'_');const payload={practice:"Southern Well Senior Concierge LLC",portal:"Care Dossier Intake & Navigation System",exportedAt:new Date().toISOString(),client:data['client']||clientName,recordData:data};const jsonStr='data:text/json;charset=utf-8,'+encodeURIComponent(JSON.stringify(payload,null,2));const dlAnchor=document.createElement('a');const fileName='SouthernWell_'+clientName+'_CareDossier_Records.json';dlAnchor.setAttribute('href',jsonStr);dlAnchor.setAttribute('download',fileName);document.body.appendChild(dlAnchor);dlAnchor.click();dlAnchor.remove();const toast=document.getElementById('export-toast');const msg=document.getElementById('export-toast-msg');if(toast&&msg){msg.textContent='Exported backup records: '+fileName;toast.style.display='flex';setTimeout(()=>{toast.style.display='none';},4500);}}</script><script>
function exportMedicationReconciliationCSV() {
  let data = {};
  try {
    data = JSON.parse(localStorage.getItem('swf') || '{}');
  } catch (e) {
    data = typeof S !== 'undefined' ? S : {};
  }

  // Identify client name & assessment date
  const clientNameRaw = data['client'] || sessionStorage.getItem('sw_auth_user') || document.querySelector('input[data-c="1"]')?.value || 'Client';
  const clientClean = clientNameRaw.trim().replace(/[^a-zA-Z0-9_-]/g, '_');
  const assessmentDate = data['k17'] || document.querySelector('#s2 input[type="date"]')?.value || new Date().toISOString().split('T')[0];
  const todayIso = new Date().toISOString().split('T')[0];

  // Find table key from data or scan the DOM inputs directly in Stage 3 card 3
  const stage3Card3 = document.querySelector('#s2 > div.card:nth-child(5)');
  let rows = [];
  
  if (stage3Card3) {
    const trs = stage3Card3.querySelectorAll('table tr');
    trs.forEach((tr, index) => {
      if (index === 0) return; // skip header tr
      const inputs = tr.querySelectorAll('input');
      if (inputs.length >= 3) {
        rows.push([
          'Slot ' + index,
          inputs[0].value.trim(),
          inputs[1].value.trim(),
          inputs[2].value.trim()
        ]);
      }
    });
  }

  // Fallback to S keys if DOM query had fewer rows
  if (rows.length === 0) {
    const tableKeys = Object.keys(data).filter(k => k.includes('_') && k.split('_').length === 3);
    for (let r = 0; r < 6; r++) {
      const col0 = data['k20_' + r + '_0'] || '';
      const col1 = data['k20_' + r + '_1'] || '';
      const col2 = data['k20_' + r + '_2'] || '';
      rows.push(['Slot ' + (r + 1), col0, col1, col2]);
    }
  }

  // Helper to escape CSV values
  const escapeCsv = (val) => {
    if (val === null || val === undefined) return '""';
    const s = String(val).replace(/"/g, '""');
    return '"' + s + '"';
  };

  // Build CSV content
  const csvLines = [];
  csvLines.push(escapeCsv('Southern Well Senior Concierge LLC — Medication Reconciliation Audit Log'));
  csvLines.push(escapeCsv('Client Legal Name') + ',' + escapeCsv(clientNameRaw));
  csvLines.push(escapeCsv('Assessment / Audit Date') + ',' + escapeCsv(assessmentDate));
  csvLines.push(escapeCsv('Export Date') + ',' + escapeCsv(todayIso));
  csvLines.push(escapeCsv('Coordinator') + ',' + escapeCsv('Jasmeen Williams, LPN, BS-HHS (Southern Well)'));
  csvLines.push(escapeCsv('Non-Clinical Scope Notice') + ',' + escapeCsv('Logistical reconciliation per prescription labels only; no clinical prescribing or hands-on administration.'));
  csvLines.push(''); // Empty line before table

  // Table Header
  const headers = ['Row / Entry', 'Medication / Supplement Name & Dose', 'Bottle Directions', 'Discrepancy Flagged (Duplicate / Expired / Low Refill)'];
  csvLines.push(headers.map(escapeCsv).join(','));

  // Table Body
  rows.forEach(r => {
    csvLines.push(r.map(escapeCsv).join(','));
  });

  const csvString = '\uFEFF' + csvLines.join('\r\n'); // Include UTF-8 BOM
  const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
  const fileName = 'SouthernWell_' + clientClean + '_Medication_Reconciliation_' + todayIso + '.csv';

  const dlAnchor = document.createElement('a');
  dlAnchor.href = URL.createObjectURL(blob);
  dlAnchor.setAttribute('download', fileName);
  document.body.appendChild(dlAnchor);
  dlAnchor.click();
  dlAnchor.remove();

  // Feedback notification via toast
  const toast = document.getElementById('export-toast');
  const msg = document.getElementById('export-toast-msg');
  if (toast && msg) {
    msg.textContent = 'Medication Reconciliation table exported as CSV (' + fileName + ')';
    toast.style.display = 'flex';
    setTimeout(() => { toast.style.display = 'none'; }, 4500);
  }
}
