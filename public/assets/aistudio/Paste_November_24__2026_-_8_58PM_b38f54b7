      },
      {
        h: 'Stage 3 of 5 • Days 4–7 In-Home Visit',
        s: '90-Minute In-Home Foundation Assessment Form — Non-Clinical Home Walkthrough, Care Dossier Intake & Medication Reconciliation Audit',
        x: [
