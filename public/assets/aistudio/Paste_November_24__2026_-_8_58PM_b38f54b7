    const VALID_PASSCODES = ["southernwell2025", "2025", "jasmeen", "swcare"];
    const AUTH_KEY = "sw_auth_authenticated";
    const AUTH_USER_KEY = "sw_auth_user";

    function checkExistingAuth() {
      const isAuth = sessionStorage.getItem(AUTH_KEY);
      const user = sessionStorage.getItem(AUTH_USER_KEY) || "Margaret E. Carlisle";
      if (isAuth === "true") {
        document.getElementById('auth-screen').style.display = 'none';
        document.getElementById('portal-content').style.display = 'flex';
        document.getElementById('active-user-display').textContent = user;
