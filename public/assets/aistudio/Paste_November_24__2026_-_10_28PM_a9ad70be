<!-- Sibling Calculator JavaScript -->
<script>
  let currentPlanPrice = 360;
  let currentPlanName = "Comprehensive Concierge";
  let siblings = 3;
  let scaleFactor = 1.0;
  const FOUNDATION_FEE = 225;

  function selectPlan(plan, price, el) {
    currentPlanPrice = price;
    currentPlanName = (plan === 'essential') ? "Essential Stewardship" : "Comprehensive Concierge";
    
    document.querySelectorAll('.plan-btn').forEach(btn => {
      btn.classList.remove('active', 'border-brass', 'bg-oxford/5', 'shadow-xs');
      btn.classList.add('border-[#E8E5DD]', 'bg-canvas');
      const dot = btn.querySelector('.radio-dot');
      if (dot) dot.classList.add('hidden');
    });

    el.classList.add('active', 'border-brass', 'bg-oxford/5', 'shadow-xs');
    el.classList.remove('border-[#E8E5DD]', 'bg-canvas');
    const activeDot = el.querySelector('.radio-dot');
    if (activeDot) activeDot.classList.remove('hidden');

    document.getElementById('display-plan-tag').textContent = currentPlanName;
    recalculateCost();
  }

  function adjustSiblings(delta) {
    const next = siblings + delta;
    if (next >= 1 && next <= 8) {
      siblings = next;
      syncSiblingUI();
    }
  }

  function setSiblings(count, el) {
    siblings = count;
    syncSiblingUI();
  }

  function syncSiblingUI() {
    document.getElementById('sibling-count-display').textContent = siblings;
    document.getElementById('sibling-count-summary').textContent = siblings === 1 ? 'Individual Member' : `Split ${siblings} ways`;
    document.getElementById('breakdown-siblings-display').textContent = siblings === 1 ? '1 Family Member' : `${siblings} Contributing Members`;

    document.querySelectorAll('.sibling-pill').forEach(pill => {
      const pillCount = parseInt(pill.getAttribute('data-siblings'));
      if (pillCount === siblings) {
        pill.classList.add('active', 'border-brass', 'bg-brass', 'text-oxford-dark', 'font-bold');
        pill.classList.remove('bg-canvas', 'border-[#E8E5DD]', 'text-obsidian/80', 'font-semibold');
      } else {
        pill.classList.remove('active', 'border-brass', 'bg-brass', 'text-oxford-dark', 'font-bold');
        pill.classList.add('bg-canvas', 'border-[#E8E5DD]', 'text-obsidian/80', 'font-semibold');
      }
    });

    recalculateCost();
  }

  function setScale(scale, el) {
    scaleFactor = scale;
    document.querySelectorAll('.scale-btn').forEach(btn => {
      btn.classList.remove('active', 'border-oxford', 'bg-oxford', 'text-canvas', 'font-semibold');
      btn.classList.add('border-[#E8E5DD]', 'bg-canvas', 'text-obsidian/80', 'font-medium');
    });
    el.classList.add('active', 'border-oxford', 'bg-oxford', 'text-canvas', 'font-semibold');
    el.classList.remove('border-[#E8E5DD]', 'bg-canvas', 'text-obsidian/80', 'font-medium');

    const slidingRow = document.getElementById('row-sliding-scale');
    const slidingDiscount = document.getElementById('sliding-discount-display');
    if (scaleFactor < 1) {
      slidingRow.style.display = 'flex';
      slidingDiscount.textContent = scaleFactor === 0.8 ? 'Tier A (-20%)' : 'Tier B (-35%)';
    } else {
      slidingRow.style.display = 'none';
    }

    recalculateCost();
  }

  function recalculateCost() {
    const adjustedRetainer = currentPlanPrice * scaleFactor;
    const monthlyPerMember = adjustedRetainer / siblings;
    const dailyPerMember = monthlyPerMember / 30;

    const includeFoundation = document.getElementById('foundation-toggle').checked;
    const foundationRow = document.getElementById('row-foundation');
    const foundationShareDisplay = document.getElementById('foundation-share-display');

    document.getElementById('share-monthly-display').textContent = '$' + monthlyPerMember.toFixed(2);
    document.getElementById('daily-share-display').textContent = 'Just ~$' + dailyPerMember.toFixed(2) + ' / day per member';
    document.getElementById('total-retainer-display').textContent = '$' + adjustedRetainer.toFixed(2) + ' / mo';

    if (includeFoundation) {
      foundationRow.style.display = 'flex';
      const foundationPerMember = (FOUNDATION_FEE * scaleFactor) / siblings;
      const totalMonth1 = monthlyPerMember + foundationPerMember;
      foundationShareDisplay.textContent = `+$${foundationPerMember.toFixed(2)} one-time ($${totalMonth1.toFixed(2)} total M1)`;
    } else {
      foundationRow.style.display = 'none';
    }
  }

  // Initialize calculation on load
  recalculateCost();
</script>




