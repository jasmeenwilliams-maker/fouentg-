const ce = (tag, a, ...k) => {
  const x = document.createElement(tag);
  Object.assign(x, a || {});
  k.forEach(i => x.append(i));
  return x;
};

function renderFormItem(it) {
  const w = ce('div');
  if (it.y == 'n') return ce('p', { className: 'note', style: 'margin:8px 0;font-style:italic;', textContent: it.x });
  if (it.y == 'x') {
    w.append(ce('span', { className: 'flab', textContent: it.l }), ce('div', { style: 'padding:8px 10px;background:#FFF;border:1px solid var(--line);border-radius:8px;font-weight:600;', textContent: it.x }));
    return w;
  }
  if (it.y == 'f') {
    w.append(ce('label', { className: 'fl', textContent: it.l }));
    const inp = ce('input', { type: it.t, value: S[it.k] || '' });
    inp.oninput = () => {
      S[it.k] = inp.value;
      saveForms();
      if (it.k == 'client') {
        document.querySelectorAll('input[data-c]').forEach(o => { if (o !== inp) o.value = inp.value; });
      }
    };
    if (it.k == 'client') inp.dataset.c = 1;
    w.append(inp);
    return w;
  }
  if (it.y == 't') {
    w.append(ce('label', { className: 'fl', textContent: it.l }));
    const ta = ce('textarea', { value: S[it.k] || '' });
    ta.oninput = () => { S[it.k] = ta.value; saveForms(); };
    w.append(ta);
    return w;
  }
  if (it.y == 'c') {
    w.append(ce('span', { className: 'flab', textContent: it.l }));
    const o = ce('div', { className: 'opts' + (it.o.some(x => x.length > 40) ? ' col' : '') });
    const boxes = [];
    it.o.forEach(v => {
      const inp = ce('input', { type: 'checkbox', checked: (S[it.k] || []).includes(v) });
      boxes.push([inp, v]);
      inp.onchange = () => {
        if (it.s && inp.checked) boxes.forEach(([b]) => { if (b !== inp) b.checked = false; });
        S[it.k] = boxes.filter(([b]) => b.checked).map(([, x]) => x);
        saveForms();
      };
      o.append(ce('label', { className: 'opt' }, inp, ce('span', { textContent: v })));
    });
    w.append(o);
    return w;
  }
  if (it.y == 'i') {
    const inp = ce('input', { type: 'text', placeholder: 'Initials', maxLength: 4, value: S[it.k] || '' });
    inp.oninput = () => { S[it.k] = inp.value; saveForms(); };
    return ce('div', { className: 'scope-bar' }, ce('p', { textContent: it.x }), inp);
  }
  if (it.y == 'b') {
    const T = ce('table'), r = ce('tr');
    it.h.forEach(h => r.append(ce('th', { textContent: h })));
    T.append(r);
    it.rows.forEach((rw, ri) => {
      const tr = ce('tr');
      it.h.forEach((_, ci) => {
        const td = ce('td');
        if (ci == 0 && it.fx && /[A-Za-z]/.test(rw) && rw.length > 3) {
          td.style.fontWeight = 'bold';
          td.style.padding = '8px 10px';
          td.textContent = rw;
        } else {
          const key = it.k + '_' + ri + '_' + ci;
          const inp = ce('input', { type: 'text', value: S[key] || '', style: 'width:100%;border:1px solid transparent;background:transparent;padding:6px;' });
          inp.oninput = () => { S[key] = inp.value; saveForms(); };
          inp.onfocus = () => { inp.style.background = '#FFF'; inp.style.borderColor = '#B08D57'; };
          inp.onblur = () => { inp.style.background = 'transparent'; inp.style.borderColor = 'transparent'; };
          td.append(inp);
        }
        tr.append(td);
      });
      T.append(tr);
    });
    return ce('div', { className: 'tw', style: 'margin:10px 0;' }, T);
  }
  if (it.y == 's') {
    w.append(ce('span', { className: 'flab', textContent: it.l }));
    const cv = ce('canvas', { className: 'sig-pad', width: 500, height: 120 });
    const g = cv.getContext('2d');
    g.lineWidth = 2;
    g.lineCap = 'round';
    g.strokeStyle = '#16263B';
    if (S[it.k]) {
      const im = new Image();
      im.onload = () => g.drawImage(im, 0, 0);
      im.src = S[it.k];
    }
    let drawing = 0;
    const getPos = ev => {
      const rect = cv.getBoundingClientRect();
      return [(ev.clientX - rect.left) * 500 / rect.width, (ev.clientY - rect.top) * 120 / rect.height];
    };
    cv.onpointerdown = ev => {
      drawing = 1;
      cv.setPointerCapture(ev.pointerId);
      const [x, y] = getPos(ev);
      g.beginPath();
      g.moveTo(x, y);
      g.lineTo(x + .1, y);
      g.stroke();
    };
    cv.onpointermove = ev => {
      if (!drawing) return;
      const [x, y] = getPos(ev);
      g.lineTo(x, y);
      g.stroke();
    };
    cv.onpointerup = () => {
      drawing = 0;
      try { S[it.k] = cv.toDataURL(); saveForms(); } catch(e) {}
    };
    const clrBtn = ce('button', { className: 'btn alt', textContent: 'Clear signature', type: 'button', style: 'margin-top:8px;padding:6px 12px;font-size:12px;' });
    clrBtn.onclick = () => {
      g.clearRect(0, 0, 500, 120);
      delete S[it.k];
      saveForms();
    };
    w.append(cv, clrBtn);
    return w;
  }
}

function formsView() {
  const container = ce('div');
  const head = ce('div', { className: 'hd' },
    ce('h2', { textContent: 'Enrollment & Required Forms (5-Stage Operational Suite)' }),
    ce('span', { className: 'pill', style: 'background:#F5EBD9;color:#7A551E;border-color:rgba(176,141,87,0.4);' }, 'Confidential Client Record')
  );
  container.append(head);

  const nav = ce('div', { className: 'forms-nav' });
  const stagesWrap = ce('div');

  FORMS_DATA.forEach((st, i) => {
    const sBox = ce('section', { className: 'stage-box' + (i === curStage ? ' on' : ''), id: 'stg' + i });
    sBox.append(
      ce('h2', { textContent: st.h }),
      ce('p', { className: 'stage-sub', textContent: st.s })
    );

    st.x.forEach(([secTitle, items]) => {
      const card = ce('div', { className: 'form-card' });
      card.append(ce('h3', { textContent: secTitle }));
      const body = ce('div', { className: 'form-body' });
      
      let gr = null;
      items.forEach(it => {
        const el = renderFormItem(it);
        if (it.y == 'f' || it.y == 'x') {
          if (!gr) {
            gr = ce('div', { className: 'form-grid' });
            body.append(gr);
          }
          gr.append(el);
        } else {
          gr = null;
          body.append(el);
        }
      });
      card.append(body);
      sBox.append(card);
    });

    const ctl = ce('div', { className: 'forms-ctl' });
    const btnBack = ce('button', { className: 'btn alt', textContent: '← Previous Stage', type: 'button' });
    btnBack.onclick = () => switchStage(i - 1);
    const btnPrint = ce('button', { className: 'btn alt', textContent: 'Print Stage ' + (i + 1), type: 'button' });
    btnPrint.onclick = () => window.print();

    ctl.append(btnBack, btnPrint);
    if (i < 4) {
      const btnNext = ce('button', { className: 'btn', textContent: 'Next Stage →', type: 'button' });
      btnNext.onclick = () => switchStage(i + 1);
      ctl.append(btnNext);
    } else {
      const btnAll = ce('button', { className: 'btn', textContent: 'Print All 5 Stages', type: 'button' });
      btnAll.onclick = () => window.print();
      ctl.append(btnAll);
    }

    sBox.append(ctl);
    stagesWrap.append(sBox);

    const navBtn = ce('button', { textContent: 'Stage ' + (i + 1), type: 'button', className: (i === curStage ? 'on' : '') });
    navBtn.onclick = () => switchStage(i);
    nav.append(navBtn);
  });

  const btnReset = ce('button', { textContent: 'Reset Forms', type: 'button', style: 'margin-left:auto;border-color:var(--err);color:var(--err);' });
  btnReset.onclick = () => {
    if (confirm('Clear every field in all 5 enrollment stages? This action cannot be undone.')) {
      S = {};
      saveForms();
      render();
    }
  };
  nav.append(btnReset);

  container.append(nav, stagesWrap);
  return container;
}

function switchStage(idx) {
  if (idx < 0 || idx > 4) return;
  curStage = idx;
  document.querySelectorAll('.stage-box').forEach((box, j) => box.classList.toggle('on', j === idx));
  document.querySelectorAll('.forms-nav button').forEach((b, j) => {
    if (j < 5) b.classList.toggle('on', j === idx);
  });
  window.scrollTo({ top: 100, behavior: 'smooth' });
}

/* ========================================================================= */
/* INTEGRATED MEDICATION SCREENING INSTRUMENTS                               */
/* ========================================================================= */
const yn = [["No", 1], ["Yes", 0]], ny = [["Yes", 1], ["No", 0]];
const MMAS_Q = [
  ["Do you sometimes forget to take your medication?", yn],
  ["People sometimes forget to take their medications for reasons other than forgetting. Thinking over the past two weeks, were there any days when you did not take your medication?", yn],
  ["Have you ever cut back or stopped taking your medication without telling your doctor, because you felt worse when you took it?", yn],
  ["When you travel or leave home, do you sometimes forget to bring your medication?", yn],
  ["Did you take your medication the last time you were supposed to take it?", ny],
  ["When you feel like your symptoms are under control, do you sometimes stop taking your medication?", yn],
  ["Taking medication every day is a real inconvenience for some people. Do you ever feel hassled about sticking to your treatment plan?", yn],
  ["How often do you have difficulty remembering to take all your medications?", [["Never/Rarely", 1], ["Once in a while", 0.75], ["Sometimes", 0.5], ["Usually", 0.25], ["All the time", 0]]]
];

const BHLS_Q = [
  ["How confident are you filling out medical forms by yourself?", [["Extremely", 5], ["Quite a bit", 4], ["Somewhat", 3], ["A little bit", 2], ["Not at all", 1]]],
  ["How often do you have someone help you read health-related materials?", [["Always", 1], ["Often", 2], ["Sometimes", 3], ["Occasionally", 4], ["Never", 5]]],
  ["How often do you have problems learning about your medical condition because of difficulty understanding written information?", [["Always", 1], ["Often", 2], ["Sometimes", 3], ["Occasionally", 4], ["Never", 5]]]
];

function medsView() {
  const q = Q();
  let h = '<div class="hd"><h2>Medication Tracker & Clinical Screening Suite</h2>' +
          '<button class="btn" data-add="meds">+ Add Medication Item</button></div>' +
          '<div class="tw"><table><tr>' +
          '<th>Client ID</th><th>Item as supplied (no doses)</th><th>Supplied by</th><th>Refill Reminder</th><th>Pharmacy</th><th>Done</th><th></th></tr>';

  D.meds.forEach(function(r, i) {
    if (q && JSON.stringify(r).toLowerCase().indexOf(q) < 0) return;
    h += '<tr>' +
         '<td>' + cell('meds', i, ["client", "Client ID", "cl"], r.client) + '</td>' +
         '<td>' + cell('meds', i, ["item", "Item as supplied"], r.item) + '</td>' +
         '<td>' + cell('meds', i, ["src", "Supplied by", "sel", ["Client", "Provider"]], r.src) + '</td>' +
         '<td>' + cell('meds', i, ["refill", "Refill reminder", "date"], r.refill) + '</td>' +
         '<td>' + cell('meds', i, ["pharm", "Pharmacy"], r.pharm) + '</td>' +
         '<td>' + cell('meds', i, ["done", "Done", "bool"], r.done) + '</td>' +
         '<td><button class="x" data-del="meds:' + i + '" aria-label="Delete row">&times;</button></td></tr>';
  });
  h += '</table></div><p class="note" style="margin-top:10px">Medication list reflects bottle labels strictly. No medical dosing changes or clinical prescriptions are made.</p>';

  // Clinical Assessment Module
  h += '<div class="card" style="margin-top:24px;">' +
       '<div class="hd"><div><h3 style="font-size:22px;color:var(--pri);">Clinical Screening Suite: Auto-Scoring Instruments</h3>' +
       '<p class="note" style="margin-top:2px;">Fillable template for Medication Adherence (MMAS-8) & Brief Health Literacy (BHLS)</p></div>' +
       '<span class="pill" style="background:#E5EFE9;color:#3D5A4C;">Validated Protocol</span></div>' +
       '<div class="form-grid" style="margin-bottom:16px;">' +
       '<label class="fl">Client ID / Name<input type="text" id="scr_name" placeholder="SW-RM-4081"></label>' +
       '<label class="fl">Assessment Date<input type="date" id="scr_date" value="' + day(0) + '"></label>' +
       '<label class="fl">Completed by<input type="text" id="scr_by" value="Jasmeen Williams, LPN"></label>' +
       '<label class="fl">Method<input type="text" id="scr_method" placeholder="Home visit, Phone, Video"></label>' +
       '</div>';

  h += '<div class="form-card"><h3>Part 1: Medication Adherence (8 Items — MMAS)</h3><div class="form-body" id="mmas_wrap"></div>' +
       '<div class="form-body" style="padding-top:0;"><div class="screen-res" id="mmasRes">Answer all 8 items to see the adherence score & protocol.</div></div></div>';

  h += '<div class="form-card"><h3>Part 2: Brief Health Literacy Screen (3 Items — BHLS)</h3><div class="form-body" id="bhls_wrap"></div>' +
       '<div class="form-body" style="padding-top:0;"><div class="screen-res" id="bhlsRes">Answer all 3 items to see the health literacy score.</div></div></div>';

  h += '<div class="form-card"><h3>Follow-Up Care Navigation Plan</h3><div class="form-body">' +
       '<label class="fl">Coordinator Action Notes<textarea id="scr_notes" placeholder="Teach-back, large print, pill box setup, provider sync..."></textarea></label>' +
       '<div class="noprint" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">' +
       '<button class="btn" onclick="window.print()">Print / Save PDF</button>' +
       '<button class="btn alt" onclick="copyScreenSummary()">Copy Summary</button>' +
       '<button class="btn alt" onclick="resetScreenForm()">Clear Screening Form</button>' +
       '<span id="scr_status" class="note" style="align-self:center;font-weight:700;color:var(--sec);"></span>' +
       '</div></div></div></div>';

  return h;
}

function initScreens() {
  const mw = document.getElementById("mmas_wrap");
  if (!mw) return;
  mw.innerHTML = MMAS_Q.map((q, i) =>
    `<div class="screen-q"><p><b>${i + 1}.</b> ${q[0]}</p><div class="screen-opts">${q[1].map(o => `<label><input type="radio" name="m${i}" value="${o[1]}" data-l="${o[0]}">${o[0]}</label>`).join("")}</div></div>`
  ).join("");

  const bw = document.getElementById("bhls_wrap");
  if (!bw) return;
  bw.innerHTML = BHLS_Q.map((q, i) =>
    `<div class="screen-q"><p><b>${i + 1}.</b> ${q[0]}</p><div class="screen-opts">${q[1].map(o => `<label><input type="radio" name="b${i}" value="${o[1]}" data-l="${o[0]}">${o[0]}</label>`).join("")}</div></div>`
  ).join("");
}

function getScreenScore(pre, n) {
  let s = 0, a = [];
  for (let i = 0; i < n; i++) {
    const r = document.querySelector(`input[name=${pre}${i}]:checked`);
    if (!r) return null;
    s += parseFloat(r.value);
    a.push(r.value);
  }
  return { s, a };
}

let screenSummaryText = {};
function calcScreens() {
  const m = getScreenScore("m", 8), b = getScreenScore("b", 3);
  const mr = document.getElementById("mmasRes"), br = document.getElementById("bhlsRes");
  if (!mr || !br) return;
  screenSummaryText = {};

  if (m) {
    const lvl = m.s < 6 ? "Low" : m.s < 8 ? "Medium" : "High";
    const act = m.s < 6 ? "Explore adherence barriers with family, review regimen with prescribing physician, consider pill box synchronization and daily reminder support." :
                m.s < 8 ? "Discuss missed-dose triggers, reinforce daily routine, offer structured pillbox setup and pharmacy auto-refill alignment." :
                "Reinforce current medication routine; rescreen during the next scheduled quarterly check-in.";
    mr.innerHTML = `<b>Score: ${m.s} / 8 (${lvl} Adherence)</b><br>${act}`;
    screenSummaryText.m = `Medication Adherence: ${m.s}/8 (${lvl})`;
  } else {
    mr.textContent = "Answer all 8 items to calculate the adherence score.";
  }

  if (b) {
    const lvl = b.s <= 9 ? "Likely Inadequate" : b.s <= 12 ? "Marginal" : "Adequate";
    const flag = b.a.some(v => v <= 3) && b.s > 9 ? " (At least one item scored ≤3: potential comprehension friction flagged)" : "";
    const act = b.s <= 12 ? "Apply teach-back methods, plain-language summaries, large print labels, and in-person verbal review of doctor instructions; involve authorized family proxy." :
                "Standard care coordination approach; continue teach-back as standard best practice.";
    br.innerHTML = `<b>Score: ${b.s} / 15 (${lvl} Health Literacy)${flag}</b><br>${act}`;
    screenSummaryText.b = `Health Literacy: ${b.s}/15 (${lvl})`;
  } else {
    br.textContent = "Answer all 3 items to calculate the health literacy score.";
  }
}

function copyScreenSummary() {
  const g = id => {
    const el = document.getElementById(id);
    return el ? el.value : '';
  };
  const t = [
    `Client: ${g("scr_name")} | Date: ${g("scr_date")} | Coordinator: ${g("scr_by")} | Method: ${g("scr_method")}`,
    screenSummaryText.m || "Medication Adherence: Incomplete",
    screenSummaryText.b || "Health Literacy: Incomplete",
    `Action Notes: ${g("scr_notes")}`
  ].join("\n");

  const st = document.getElementById("scr_status");
  try {
    navigator.clipboard.writeText(t).then(() => {
      if (st) st.textContent = "✓ Summary copied to clipboard";
    }, () => {
      if (st) st.textContent = "Select & copy manually.";
    });
  } catch(e) {
    if (st) st.textContent = "Copy unavailable in this browser context.";
  }
}

function resetScreenForm() {
  document.querySelectorAll('#mmas_wrap input, #bhls_wrap input').forEach(r => r.checked = false);
  const notes = document.getElementById("scr_notes");
  if (notes) notes.value = "";
  calcScreens();
  const st = document.getElementById("scr_status");
  if (st) st.textContent = "";
}

function renderNav() {
  var el = document.getElementById("nav");
  if (!el) return;
  var h = '<div class="brand"><div class="brand-lockup">' +
          '<div class="brand-mark">' + iconSvg("mark") + '</div>' +
          '<div><b>SOUTHERN WELL</b><small>Senior Concierge</small></div>' +
          '</div></div>';
  NAV.forEach(function(item) {
    var active = V === item[0] ? ' class="on"' : '';
    h += '<a href="#' + item[0] + '" data-nav="' + item[0] + '"' + active + '>' +
         '<span class="nav-icon">' + iconSvg(item[2]) + '</span>' +
         '<span>' + item[1] + '</span></a>';
  });
  el.innerHTML = h;
}

function render() {
  load();
  renderNav();
  var v = document.getElementById("v");
  if (!v) return;
  if (V === "dashboard") v.innerHTML = dash();
  else if (V === "workflow") v.innerHTML = flow();
  else if (V === "forms") {
    v.innerHTML = "";
    v.append(formsView());
  } else if (V === "meds") {
    v.innerHTML = medsView();
    initScreens();
  } else if (M[V]) v.innerHTML = mod(V);
  else v.innerHTML = '<div class="card"><h3>' + V.toUpperCase() + '</h3><p class="note">Section active.</p></div>';
}

// Global Operations Event Listeners
document.addEventListener("click", function(e) {
  var nav = e.target.closest("[data-nav]");
  if (nav) {
    e.preventDefault();
    V = nav.getAttribute("data-nav");
    render();
    return;
  }
  var pre = e.target.closest("[data-pre]");
  if (pre) {
    D.preset = pre.getAttribute("data-pre");
    save();
    render();
    return;
  }
  var add = e.target.closest("[data-add]");
  if (add) {
    var k = add.getAttribute("data-add");
    if (k === "clients") {
      var nextNum = D.clients.length + 1;
      D.clients.unshift({
        id: "SW-NEW-" + nextNum,
        ini: "N.C.",
        county: "Forrest",
        pkg: "Essentials",
        step: 0,
        next: day(3),
        visit: "Discovery Call",
        status: "Active",
        contact: "Phone",
        packet: "Not started",
        consent: false,
        porch: "Standard",
        needs: "Intake scheduled"
      });
    } else if (M[k]) {
      var emptyRow = {};
      M[k].c.forEach(function(col) { emptyRow[col[0]] = ""; });
      D[k].unshift(emptyRow);
    }
    save();
    render();
    return;
  }
  var del = e.target.closest("[data-del]");
  if (del) {
    var parts = del.getAttribute("data-del").split(":");
    D[parts[0]].splice(parseInt(parts[1], 10), 1);
    save();
    render();
    return;
  }
  var mv = e.target.closest("[data-mv]");
  if (mv) {
    var p = mv.getAttribute("data-mv").split(":");
    var idx = parseInt(p[0], 10), diff = parseInt(p[1], 10);
    if (D.clients[idx]) {
      D.clients[idx].step = Math.max(0, Math.min(9, (D.clients[idx].step || 0) + diff));
      save();
      render();
    }
    return;
  }
  var exp = e.target.closest("[data-export-caseload]");
  if (exp) {
    var csv = "Client ID,Initials,County,Package,Status,Next Check-In\n";
    D.clients.forEach(function(c) {
      csv += [c.id, c.ini, c.county, c.pkg, c.status, c.next].join(",") + "\n";
    });
    var blob = new Blob([csv], { type: "text/csv" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = "southernwell_caseload_ledger.csv";
    a.click();
    return;
  }
});

document.addEventListener("change", function(e) {
  var t = e.target;
  if (t.dataset && t.dataset.k) {
    var k = t.dataset.k, i = parseInt(t.dataset.i, 10), f = t.dataset.f;
    var val = t.type === "checkbox" ? t.checked : t.dataset.t === "n" ? parseInt(t.value, 10) : t.value;
    if (D[k] && D[k][i]) {
      D[k][i][f] = val;
      save();
    }
  }
  if (t.name && (t.name.startsWith("m") || t.name.startsWith("b"))) {
    calcScreens();
  }
});

// Auto-check session storage on startup
document.addEventListener("DOMContentLoaded", function() {
  if (sessionStorage.getItem(PIN_SESSION_KEY) === "authenticated") {
    unlockHub();
  }
  render();
});

render();
</script>
