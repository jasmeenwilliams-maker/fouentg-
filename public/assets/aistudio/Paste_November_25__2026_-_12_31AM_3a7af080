<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Southern Well Operations Hub — Secure Coordinator Command</title>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #F7F5F0;
  --bg-2: #EFECE5;
  --card: #FFFFFF;
  --ink: #1A1B1E;
  --mut: #68696D;
  --pri: #16263B;
  --pri-dark: #0F1B2B;
  --pc: #3D5A4C;
  --pcl: #E5EFE9;
  --on: #FFFFFF;
  --sec: #B08D57;
  --sec-dark: #8F6E3B;
  --sc: #F5EBD9;
  --line: #E8E5DD;
  --surf: #FAF9F6;
  --err: #9E3524;
  --eb: #FDE8E5;
  --ok: #3D5A4C;
  --ok-bg: #E5EFE9;
  --shadow: 0 24px 50px rgba(22, 38, 59, 0.08), 0 8px 20px rgba(22, 38, 59, 0.04);
  --shadow-soft: 0 12px 24px rgba(22, 38, 59, 0.05);
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.85), transparent 25%),
              radial-gradient(circle at bottom right, rgba(176, 141, 87, 0.08), transparent 30%),
              linear-gradient(135deg, var(--bg-2) 0%, var(--bg) 35%, #FAF9F6 100%);
  color: var(--ink);
  font: 14px/1.45 "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  min-height: 100vh;
}

h1, h2, h3 {
  font-family: Newsreader, Georgia, serif;
  color: var(--pri);
  margin: 0;
  letter-spacing: -0.025em;
}

.app {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  padding: 22px;
  max-width: 1540px;
  margin: 0 auto;
}

/* Sidebar - Deep Oxford Navy (15% System) */
.side {
  width: 275px;
  flex: none;
  position: sticky;
  top: 20px;
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  background: linear-gradient(180deg, #16263B 0%, #0F1B2B 100%);
  border: 1px solid rgba(176, 141, 87, 0.22);
  box-shadow: 0 20px 45px rgba(22, 38, 59, 0.28);
  border-radius: 24px;
  padding: 18px 12px;
  color: #F7F5F0;
}

.brand {
  padding: 8px 10px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 10px;
}
.brand b {
  font: 600 23px Newsreader, serif;
  color: #FFFFFF;
  display: block;
  letter-spacing: -0.03em;
}
.brand small {
  color: #DFC9A2;
  font-weight: 700;
  letter-spacing: 0.16em;
  font-size: 10px;
  text-transform: uppercase;
}
.brand-lockup {
  display: flex;
  align-items: center;
  gap: 12px;
}
.brand-mark {
  width: 40px;
  height: 40px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(145deg, #16263B, #0F1B2B);
  border: 1.5px solid #B08D57;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
}
.brand-mark svg {
  width: 24px;
  height: 24px;
  fill: none;
  stroke: #DFC9A2;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.side a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  color: #B7C3D3;
  cursor: pointer;
  text-decoration: none;
  margin: 3px 0;
  transition: all 0.18s ease;
  border: 1px solid transparent;
  font-weight: 600;
  letter-spacing: 0.01em;
  font-size: 13.5px;
}
.side a:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #FFFFFF;
  border-color: rgba(176, 141, 87, 0.2);
  transform: translateX(2px);
}
.side a.on {
  background: linear-gradient(135deg, #B08D57 0%, #8F6E3B 100%);
  color: #FFFFFF;
  font-weight: 700;
  border: 1px solid #DFC9A2;
  box-shadow: 0 10px 22px rgba(176, 141, 87, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.nav-icon {
  width: 28px;
  height: 28px;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #DFC9A2;
}
.nav-icon svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  stroke-width: 1.75;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}
.side a.on .nav-icon {
  background: rgba(22, 38, 59, 0.25);
  border-color: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

/* Main Workspace Canvas */
.main {
  flex: 1;
  min-width: 0;
  padding: 6px 2px 40px;
}

.top {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 16px;
}
#q {
  min-width: 260px;
  box-shadow: var(--shadow-soft);
}

.ban {
  background: linear-gradient(135deg, rgba(245, 235, 217, 0.95), rgba(255, 255, 255, 0.85));
  border: 1px solid rgba(176, 141, 87, 0.35);
  border-radius: 16px;
  padding: 12px 16px;
  font-size: 12.5px;
  margin-bottom: 18px;
  border-left: 6px solid var(--sec);
  box-shadow: 0 10px 25px rgba(176, 141, 87, 0.08);
  color: #4A3A22;
}

input, select, textarea {
  font: inherit;
  color: var(--ink);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 9px 12px;
  max-width: 100%;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: #B08D57;
  box-shadow: 0 0 0 4px rgba(176, 141, 87, 0.15);
}

/* BUTTONS — Brushed Brass Primary & Concierge Styling */
.btn {
  background: linear-gradient(135deg, #B08D57 0%, #9C7A45 50%, #85632F 100%);
  color: #FFFFFF;
  border: 1px solid #DFC9A2;
  border-radius: 12px;
  padding: 9px 16px;
  font: 700 13px inherit;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  box-shadow: 0 10px 22px rgba(176, 141, 87, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
}
.btn:hover {
  transform: translateY(-1.5px);
  box-shadow: 0 14px 28px rgba(176, 141, 87, 0.36);
  background: linear-gradient(135deg, #BE9B63 0%, #AA874F 50%, #906C35 100%);
}

.btn.alt {
  background: #FFFFFF;
  color: #7A551E;
  border: 1.5px solid rgba(176, 141, 87, 0.45);
  box-shadow: 0 4px 12px rgba(22, 38, 59, 0.04);
}
.btn.alt:hover {
  background: rgba(176, 141, 87, 0.10);
  border-color: #B08D57;
  color: #5C3D10;
  transform: translateY(-1px);
}

.btn.on {
  background: linear-gradient(135deg, #B08D57 0%, #8F6E3B 100%) !important;
  color: #FFFFFF !important;
  border-color: #DFC9A2 !important;
  outline: 2px solid #B08D57;
  outline-offset: 1px;
}

.btn.lock {
  background: linear-gradient(135deg, #16263B 0%, #0F1B2B 100%);
  color: #DFC9A2;
  border: 1px solid rgba(176, 141, 87, 0.4);
}
.btn.lock:hover {
  background: #0B1623;
  color: #FFFFFF;
  border-color: #B08D57;
}

.dash-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0 0 18px;
}
.dash-action-icon {
  display: inline-flex;
  width: 17px;
  height: 17px;
}
.dash-action-icon svg {
  width: 17px;
  height: 17px;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}

/* Cards & KPI Tiles */
.hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  gap: 12px;
}
.hd h2 {
  font-size: clamp(28px, 2.8vw, 38px);
  color: var(--pri);
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}

.card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAF8F4 100%);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 16px;
  box-shadow: var(--shadow-soft);
  position: relative;
  overflow: hidden;
}
.card::before {
  content: "";
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, #B08D57 0%, #16263B 50%, #3D5A4C 100%);
  opacity: 0.9;
}

.kpi {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(176, 141, 87, 0.16);
}
.kpi .icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  margin-bottom: 12px;
  border-radius: 12px;
  background: linear-gradient(145deg, #E5EFE9, #D2E4DA);
  border: 1px solid rgba(61, 90, 76, 0.22);
  color: #3D5A4C;
}
.kpi .icon svg {
  width: 21px;
  height: 21px;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}
.kpi.bad .icon {
  background: linear-gradient(145deg, #FDE8E5, #FAD0CA);
  border-color: rgba(158, 53, 36, 0.25);
  color: #9E3524;
}

.kpi small {
  color: var(--mut);
  text-transform: uppercase;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
}
.kpi b {
  display: block;
  font: 600 36px Newsreader, serif;
  color: var(--pri);
  margin-top: 6px;
  letter-spacing: -0.03em;
}
.kpi.bad b, .bad { color: var(--err); }
.kpi .lim { font-size: 12px; color: var(--mut); font-weight: 500; }

.bar {
  display: flex;
  height: 12px;
  border-radius: 999px;
  overflow: hidden;
  background: #E8E5DD;
  margin: 10px 0;
  border: 1px solid rgba(22, 38, 59, 0.06);
}
.bar i { display: block; height: 100%; transition: width 0.3s ease; }

.pill {
  background: var(--pcl);
  border: 1px solid rgba(61, 90, 76, 0.2);
  border-radius: 999px;
  padding: 4px 11px;
  font-size: 12px;
  color: var(--pc);
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.li {
  padding: 10px 0;
  border-top: 1px solid var(--line);
  font-size: 13.5px;
}
.li:first-child { border: 0; }
.note { color: var(--mut); font-size: 12px; }

/* Tables */
.tw {
  overflow-x: auto;
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: var(--shadow-soft);
}
table {
  border-collapse: collapse;
  width: 100%;
  min-width: 680px;
}
th {
  background: linear-gradient(180deg, #16263B 0%, #1A2B42 100%);
  text-align: left;
  font-size: 11px;
  text-transform: uppercase;
  padding: 12px 10px;
  color: #DFC9A2;
  letter-spacing: 0.1em;
  font-weight: 700;
}
td {
  padding: 10px 8px;
  border-top: 1px solid var(--line);
  vertical-align: middle;
}
tbody tr:nth-child(even) { background: rgba(247, 245, 240, 0.5); }
td input:not([type=checkbox]), td select {
  width: 100%;
  min-width: 90px;
  border: 1px solid transparent;
  background: transparent;
  border-radius: 8px;
  padding: 6px 8px;
}
td input:focus, td select:focus {
  background: #FFFFFF;
  border-color: #B08D57;
}

.x {
  background: rgba(158, 53, 36, 0.08);
  border: 0;
  color: var(--err);
  font-size: 18px;
  cursor: pointer;
  border-radius: 8px;
  padding: 4px 8px;
  transition: all 0.15s ease;
}
.x:hover { background: rgba(158, 53, 36, 0.16); }

/* Pipeline Board */
.board {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  align-items: flex-start;
  padding-bottom: 12px;
}
.col {
  flex: 0 0 230px;
  background: linear-gradient(180deg, #FFFFFF 0%, #FAF8F4 100%);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 12px;
  box-shadow: var(--shadow-soft);
}
.col h3 {
  font: 700 12.5px "DM Sans", sans-serif;
  margin: 4px 2px 10px;
  letter-spacing: 0.03em;
  color: var(--pri);
  display: flex;
  align-items: center;
}
.col .step-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: #E5EFE9;
  color: #3D5A4C;
  font-size: 11px;
  font-weight: 800;
  margin-right: 6px;
}
.cc {
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-left: 4px solid #B08D57;
  border-radius: 12px;
  padding: 10px;
  margin-bottom: 8px;
  box-shadow: 0 6px 14px rgba(22, 38, 59, 0.04);
}
.cc .r { display: flex; gap: 4px; margin-top: 8px; }
.cc button {
  flex: 1;
  background: var(--surf);
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--ink);
  cursor: pointer;
  padding: 6px 4px;
  font-weight: 700;
  font-size: 12px;
}
.cc button:hover {
  background: #E5EFE9;
  border-color: #3D5A4C;
  color: #3D5A4C;
}

/* ========================================================================= */
/* PIN CODE SECURITY OVERLAY (COORDINATOR LOCK GATE)                         */
/* ========================================================================= */
#pin-lock-overlay {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: radial-gradient(circle at center, #1B2B42 0%, #0F1B2B 70%, #09101A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
#pin-lock-overlay.unlocked {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.pin-dialog {
  width: 100%;
  max-width: 420px;
  background: #FFFFFF;
  border: 2px solid #B08D57;
  border-radius: 28px;
  padding: 32px 28px;
  text-align: center;
  box-shadow: 0 35px 80px rgba(0, 0, 0, 0.45), 0 10px 30px rgba(176, 141, 87, 0.2);
  position: relative;
  overflow: hidden;
}
.pin-dialog::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 5px;
  background: linear-gradient(90deg, #16263B, #B08D57, #3D5A4C);
}
.pin-icon-wrap {
  width: 68px;
  height: 68px;
  margin: 0 auto 16px;
  border-radius: 22px;
  background: linear-gradient(135deg, #16263B, #0F1B2B);
  border: 2px solid #B08D57;
  display: grid;
  place-items: center;
  color: #DFC9A2;
  box-shadow: 0 10px 24px rgba(22, 38, 59, 0.3);
}
.pin-icon-wrap svg {
  width: 34px;
  height: 34px;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}
.pin-dialog h2 {
  font: 600 28px Newsreader, serif;
  color: #16263B;
  margin: 0 0 6px;
  letter-spacing: -0.02em;
}
.pin-dialog p {
  color: #68696D;
  font-size: 13px;
  margin: 0 0 20px;
  line-height: 1.45;
}

.pin-display-dots {
  display: flex;
  justify-content: center;
  gap: 14px;
  margin: 20px 0 24px;
}
.pin-dot {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #B08D57;
  background: #FAF9F6;
  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.pin-dot.filled {
  background: #16263B;
  border-color: #16263B;
  transform: scale(1.15);
  box-shadow: 0 0 0 3px rgba(176, 141, 87, 0.3);
}
.pin-dot.error {
  background: #9E3524;
  border-color: #9E3524;
}

.pin-keypad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  max-width: 290px;
  margin: 0 auto 16px;
}
.key-btn {
  background: #FAF9F6;
  border: 1px solid #E8E5DD;
  color: #16263B;
  font-size: 20px;
  font-weight: 700;
  border-radius: 14px;
  height: 52px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  user-select: none;
}
.key-btn:hover {
  background: #E5EFE9;
  border-color: #B08D57;
  color: #16263B;
  transform: scale(1.04);
}
.key-btn:active {
  transform: scale(0.96);
  background: #DFC9A2;
}
.key-btn.fn {
  font-size: 13px;
  font-weight: 800;
  color: #7A551E;
  letter-spacing: 0.05em;
  background: #F7F5F0;
}

#pin-error-msg {
  min-height: 20px;
  font-size: 12.5px;
  font-weight: 700;
  color: #9E3524;
  margin-top: 8px;
}

/* ========================================================================= */
/* INTEGRATED ENROLLMENT FORMS & CLINICAL SCREENING STYLING                  */
/* ========================================================================= */
.forms-nav {
  display: flex;
  gap: 8px;
  justify-content: flex-start;
  flex-wrap: wrap;
  padding: 12px 0 16px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 16px;
}
.forms-nav button {
  font: inherit;
  font-size: 12.5px;
  border: 1px solid rgba(176, 141, 87, 0.4);
  background: #FFFFFF;
  color: var(--ink);
  padding: 7px 14px;
  border-radius: 20px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.15s ease;
}
.forms-nav button:hover {
  border-color: var(--sec);
  background: var(--surf);
}
.forms-nav button.on {
  background: linear-gradient(135deg, #16263B, #0F1B2B);
  color: #FFFFFF;
  border-color: #16263B;
  box-shadow: 0 4px 10px rgba(22,38,59,0.18);
}
.forms-nav button.done::after {
  content: " ✓";
  color: #DFC9A2;
}

.stage-box { display: none; }
.stage-box.on { display: block; }
.stage-box > h2 {
  color: var(--pri);
  margin: 6px 0 2px;
  font-size: 24px;
}
.stage-sub {
  font-style: italic;
  margin: 2px 0 14px;
  font-size: 13px;
  color: var(--mut);
}

.form-card {
  background: #FFFFFF;
  border: 1px solid var(--line);
  border-radius: 16px;
  margin: 14px 0;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
}
.form-card h3 {
  margin: 0;
  background: linear-gradient(180deg, #16263B 0%, #1A2B42 100%);
  color: #DFC9A2;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 10px 14px;
  font-family: "DM Sans", sans-serif;
  font-weight: 700;
}
.form-body { padding: 14px; background: #FAF9F6; }
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 12px;
}
label.fl, .flab {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--pri);
  margin: 8px 0 4px;
}
.form-card input[type=text], .form-card input[type=date], .form-card input[type=datetime-local], .form-card textarea {
  width: 100%;
  font: inherit;
  padding: 8px 10px;
  border: 1px solid var(--line);
  background: #FFFFFF;
  color: var(--ink);
  border-radius: 8px;
}
.form-card textarea { min-height: 75px; }

.opts { display: flex; flex-wrap: wrap; gap: 6px 16px; }
.opts.col { flex-direction: column; }
.opt {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  cursor: pointer;
  padding: 3px 0;
  font-size: 13px;
}
.opt input {
  margin-top: 3px;
