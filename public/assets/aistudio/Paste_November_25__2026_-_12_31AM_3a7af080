function updatePinDots() {
  for (let i = 0; i < 4; i++) {
    const dot = document.getElementById(`dot-${i}`);
    if (dot) {
      dot.className = "pin-dot" + (i < enteredPin.length ? " filled" : "");
    }
  }
}

function unlockHub() {
  const overlay = document.getElementById("pin-lock-overlay");
  if (overlay) {
    overlay.classList.add("unlocked");
    sessionStorage.setItem(PIN_SESSION_KEY, "authenticated");
  }
  enteredPin = "";
  updatePinDots();
  const err = document.getElementById("pin-error-msg");
  if (err) err.textContent = "";
}

function lockHub() {
  const overlay = document.getElementById("pin-lock-overlay");
  if (overlay) {
    overlay.classList.remove("unlocked");
    sessionStorage.removeItem(PIN_SESSION_KEY);
  }
  enteredPin = "";
  updatePinDots();
  const err = document.getElementById("pin-error-msg");
  if (err) err.textContent = "";
}

function handleKeyInput(val) {
  const err = document.getElementById("pin-error-msg");
  if (err) err.textContent = "";

  if (val === "clr") {
    enteredPin = "";
    updatePinDots();
    return;
  }
  if (val === "del") {
    enteredPin = enteredPin.slice(0, -1);
    updatePinDots();
    return;
  }
  if (enteredPin.length < 4 && /^[0-9]$/.test(val)) {
    enteredPin += val;
    updatePinDots();

    if (enteredPin.length === 4) {
      setTimeout(() => {
        if (VALID_PINS.includes(enteredPin)) {
          unlockHub();
        } else {
          for (let i = 0; i < 4; i++) {
            const dot = document.getElementById(`dot-${i}`);
            if (dot) dot.classList.add("error");
          }
          if (err) err.textContent = "Incorrect authorization PIN. Try again.";
          setTimeout(() => {
            enteredPin = "";
            updatePinDots();
          }, 600);
        }
      }, 150);
    }
  }
}

