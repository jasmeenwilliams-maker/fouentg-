  } else if (type === "likert") {
    opts = '<select onchange="updateMMAS(\'' + qid + '\', this.value)" style="width:180px">' +
           '<option value="4"' + (val === 4 ? ' selected' : '') + '>Never/Rarely (0 pts)</option>' +
           '<option value="3"' + (val === 3 ? ' selected' : '') + '>Once in a while (0.25 pt)</option>' +
           '<option value="2"' + (val === 2 ? ' selected' : '') + '>Sometimes (0.50 pt)</option>' +
           '<option value="1"' + (val === 1 ? ' selected' : '') + '>Usually (0.75 pt)</option>' +
           '<option value="0"' + (val === 0 ? ' selected' : '') + '>All the time (1 pt)</option>' +
           '</select>';
  }
  return '<div class="screen-q"><div><b>' + esc(text) + '</b></div><div>' + opts + '</div></div>';
}

function renderBHLSQuestion(qid, text) {
  var val = D.bhlsResponses[qid];
  var labels = (qid === "q2")
    ? ["1 - Not at all", "2 - A little bit", "3 - Somewhat", "4 - Quite a bit", "5 - Extremely confident"]
    : ["1 - Always", "2 - Often", "3 - Sometimes", "4 - Occasionally", "5 - Never"];
  var opts = '<select onchange="updateBHLS(\'' + qid + '\', this.value)" style="width:200px">';
  for (var i = 1; i <= 5; i++) {
    opts += '<option value="' + i + '"' + (val === i ? ' selected' : '') + '>' + labels[i - 1] + '</option>';
  }
  opts += '</select>';
  return '<div class="screen-q"><div><b>' + esc(text) + '</b></div><div>' + opts + '</div></div>';
}

function updateMMAS(qid, val) {
  D.mmasResponses[qid] = parseInt(val, 10);
  save();
  render();
}

function updateBHLS(qid, val) {
  D.bhlsResponses[qid] = parseInt(val, 10);
  save();
  render();
}

function calcMMAS() {
  var r = D.mmasResponses;
  var sum = 0;
  if (r.q1 === 1) sum += 1;
  if (r.q2 === 1) sum += 1;
  if (r.q3 === 1) sum += 1;
  if (r.q4 === 1) sum += 1;
  if (r.q5 === 1) sum += 1;
  if (r.q6 === 1) sum += 1;
  if (r.q7 === 1) sum += 1;
  var q8 = r.q8 != null ? r.q8 : 4;
  if (q8 === 4) sum += 1.0;
  else if (q8 === 3) sum += 0.75;
  else if (q8 === 2) sum += 0.50;
  else if (q8 === 1) sum += 0.25;

  if (sum === 8) {
    return { score: 8, label: "High Adherence", color: "#3D5A4C", recommendation: "Standard monthly pill tray reconciliation and refill reminder calls. Client exhibits optimal routine compliance." };
  } else if (sum >= 6) {
    return { score: sum, label: "Medium Adherence", color: "#B08D57", recommendation: "Implement color-coded 7-day pillbox trays with twice-weekly phone reminders. Synchronize refill cycles with Highland Pharmacy." };
  } else {
    return { score: sum, label: "Low Adherence (Intervention Needed)", color: "#9E3524", recommendation: "Flag for in-home blister-pack transition (Dispill/Bubble-pack). Coordinate clinic accompaniment to address side-effect concerns with prescribing physician." };
  }
}

function calcBHLS() {
  var r = D.bhlsResponses;
  var sum = (r.q1 || 3) + (r.q2 || 3) + (r.q3 || 3);
  if (sum >= 13) {
    return { score: sum, label: "Adequate Health Literacy", color: "#3D5A4C", recommendation: "Provide standard SouthernWell 5-Tab Binder instructions. Client navigates appointment paperwork independently." };
  } else if (sum >= 10) {
    return { score: sum, label: "Marginal Health Literacy", color: "#B08D57", recommendation: "Highlight key dates and physician instructions with yellow markers. Coordinator reviews appointment summaries verbally during post-visit call." };
  } else {
    return { score: sum, label: "Inadequate Health Literacy (Active Advocacy Required)", color: "#9E3524", recommendation: "Mandatory in-person clinic accompaniment. Coordinator handles intake paperwork and utilizes Teach-Back technique for non-clinical instructions." };
  }
}

function copyScreenSummary() {
  var m = calcMMAS();
  var b = calcBHLS();
  var text = "SOUTHERNWELL CLINICAL CARE COORDINATION SUMMARY\n" +
             "--------------------------------------------------\n" +
             "Morisky Adherence (MMAS-8): " + m.score.toFixed(2) + "/8.0 (" + m.label + ")\n" +
             "Recommendation: " + m.recommendation + "\n\n" +
             "Brief Health Literacy (BHLS): " + b.score + "/15 (" + b.label + ")\n" +
             "Directive: " + b.recommendation + "\n" +
             "--------------------------------------------------\n" +
             "Recorded by: SouthernWell Senior Concierge Navigation Hub";
  navigator.clipboard.writeText(text).then(function() {
    alert("Screening summary copied to clipboard! You can paste this into client notes or share with the attending physician.");
  });
}

